### General Variables
project_id     = "naconfeitaria"
project_number = "123456789012"
region         = "southamerica-east1"
zone           = "southamerica-east1-a"

### APIs Module Variables
services_apis_list = [
  "compute.googleapis.com",
  "container.googleapis.com",
  "sqladmin.googleapis.com",
  "servicenetworking.googleapis.com",
  "storage.googleapis.com",
  "storage-component.googleapis.com",
  "secretmanager.googleapis.com",
  "artifactregistry.googleapis.com",
  "iam.googleapis.com",
  "iamcredentials.googleapis.com",
  "cloudresourcemanager.googleapis.com",
  "sts.googleapis.com",
  "monitoring.googleapis.com",
  "logging.googleapis.com",
  "generativelanguage.googleapis.com",
  "serviceusage.googleapis.com"
]

### Bucket Module Variables
buckets = {
  "loki" = {
    bucket_name = "gcs-loki-bucket-solidary-tech-rh"
    labels_bucket = {
      environment = "production"
      service     = "loki"
      managed_by  = "terraform"
    }
  },
  "velero" = {
    bucket_name = "gcs-velero-bucket-solidary-tech-rh"
    labels_bucket = {
      environment = "production"
      service     = "velero"
      managed_by  = "terraform"
    }
  }
}

### Service Account Module Variables
service_accounts = {
  "sa-gke-fiap" = "GKE Service Account para Workload Identity"
}

sa_wifederation_email = "sa-gke-fiap@naconfeitaria.iam.gserviceaccount.com"

### VPC Module Variables
vpc_name    = "vpc-rhuan"
router_name = "router-rhuan"
nat_name    = "nat-rhuan"
psa_name    = "psa-rhuan"

subnets = {
  "southamerica" = {
    name                   = "subnet-gke-sa"
    region                 = "southamerica-east1"
    ip_cidr_range          = "10.0.0.0/24"
    range_name_pods        = "pods-subnet-sa"
    ip_cidr_range_pods     = "10.1.0.0/16"
    range_name_services    = "services-subnet-sa"
    ip_cidr_range_services = "10.2.0.0/20"
  },
  "useast" = {
    name                   = "subnet-gke-us"
    region                 = "us-east1"
    ip_cidr_range          = "10.4.0.0/24"
    range_name_pods        = "pods-subnet-us"
    ip_cidr_range_pods     = "10.5.0.0/16"
    range_name_services    = "services-subnet-us"
    ip_cidr_range_services = "10.6.0.0/20"
  }
}

### Cloud SQL Module Variables
database_version            = "POSTGRES_14"
enable_cross_region_replica = true
replica_region              = "us-east1"
instance_labels = {
  environment = "production"
  managed_by  = "terraform"
  project     = "solidary-tech"
}

cloud_sql = {
  "ngo-service" = {
    database_version        = "POSTGRES_14"
    instance_tier           = "db-custom-2-7680"
    cloud_sql_instance_name = "sql-rhuan-ngo"
    database_name           = "ngodb"
    username                = "postgres"
    instance_labels = {
      environment = "production"
      service     = "ngo-service"
      managed_by  = "terraform"
    }
    password = {
      secret_id   = "sm-ngo-service-db-password"
      secret_data = "ChangeMeNgo123!"
    }
  },
  "donation-service" = {
    database_version        = "POSTGRES_14"
    instance_tier           = "db-custom-2-7680"
    cloud_sql_instance_name = "sql-rhuan-donation"
    database_name           = "donationdb"
    username                = "postgres"
    instance_labels = {
      environment = "production"
      service     = "donation-service"
      managed_by  = "terraform"
    }
    password = {
      secret_id   = "sm-donation-service-db-password"
      secret_data = "ChangeMeDonation123!"
    }
  }
}

### GKE Module Variables
gke = {
  "southamerica" = {
    cluster_name     = "gke-samerica"
    region           = "southamerica-east1"
    should_be_create = true
  },
  "useast" = {
    cluster_name     = "gke-useast"
    region           = "us-east1"
    should_be_create = false
  }
}

gke_resource_labels = {
  environment = "production"
  project     = "solidary-tech"
  team        = "sre"
  managed_by  = "terraform"
}

sa_inside_gke = "sa-gke"

