---
kind: HTTPRoute
apiVersion: gateway.networking.k8s.io/v1
metadata:
  name: volunteer-httproute
  namespace: volunteer-ns
spec:
  parentRefs:
  - name: gateway-applications
    namespace: gateway-api-ns
  hostnames:
  - "solidary-tech.${GATEWAY_IP}.nip.io"
  rules:
  - matches:
    - path:
        type: PathPrefix
        value: /volunteer-service
    backendRefs:
    - name: volunteer-service
      port: 80
