---
kind: HTTPRoute
apiVersion: gateway.networking.k8s.io/v1
metadata:
  name: donation-httproute
  namespace: donation-ns
spec:
  parentRefs:
  - name: gateway-applications
    namespace: gateway-api-ns
    sectionName: https
  hostnames:
  - "solidary-tech.${GATEWAY_IP}.nip.io"
  rules:
  - matches:
    - path:
        type: PathPrefix
        value: /donation-service
    backendRefs:
    - name: donation-service
      port: 80
