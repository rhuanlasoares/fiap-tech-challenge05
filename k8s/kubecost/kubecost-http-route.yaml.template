---
kind: HTTPRoute
apiVersion: gateway.networking.k8s.io/v1
metadata:
  name: kubecost-httproute
  namespace: kubecost
spec:
  parentRefs:
  - name: gateway-applications
    namespace: gateway-api-ns
  hostnames:
  - "kubecost.${GATEWAY_IP}.nip.io"
  rules:
  - matches:
    - path:
        type: PathPrefix
        value: /
    backendRefs:
    - name: kubecost-frontend
      port: 9090
